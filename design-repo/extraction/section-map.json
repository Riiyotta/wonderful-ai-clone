        {
          "section": "features.approach-cards",
          "sel": "#aios + div"
        },
        {
          "section": "features.industry-tabs",
          "sel": "#Industries"
        },
        {
          "section": "conversion.team-closer",
          "sel": "#Closer"
        }
      ]
    },
