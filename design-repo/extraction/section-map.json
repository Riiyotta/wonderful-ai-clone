{
  "$description": "How extraction/measure_sections.mjs attributes rendered DOM boxes to section contracts at 1440x900. Selectors are CSS selectors over the rendered clone DOM (provenance only, never contract vocabulary). Step kinds: sel (first visible match), selAll (each visible match), union (one box spanning several selectors), chunks (heading-bounded parts of a prose container), classmap (children of a container mapped by class), blocks (in-flow top-level blocks in order, descending through single wrappers). flow=fixed|sticky|absolute marks boxes that take no page height in the wrapper gate.",
  "version": "1.0.0",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "headingSelector": "h1,h2,h3,h4,h5",
  "paragraphSelector": "p,li,blockquote",
  "shell": {
    "site-header": {
      "section": "shell.site-header",
      "sel": "header.nv",
      "flow": "fixed"
    },
    "site-footer-dark": {
      "section": "shell.site-footer",
      "variant": "dark-columns",
      "sel": "footer[data-framer-name='L']"
    },
    "site-footer-light": {
      "section": "shell.site-footer",
      "variant": "light-band",
      "sel": "footer.lf"
    },
    "campaign-footer": {
      "section": "shell.campaign-footer",
      "variant": "campaign",
      "sel": "footer.fcb-footer"
    }
  },
  "templates": {
    "home": {
      "shell": [
        "site-header",
        "site-footer-dark"
      ],
      "steps": [
        {
          "section": "hero.video-statement",
          "sel": "main > section:nth-of-type(1)"
        },
        {
          "section": "social-proof.logo-grid",
          "variant": "grid-12",
          "sel": "#logos"
        },
        {
          "section": "social-proof.case-study-carousel",
          "variant": "light",
          "sel": "#team"
        },
        {
          "section": "content.reveal-statement",
          "variant": "scroll-color",
          "sel": "#vision"
        },
