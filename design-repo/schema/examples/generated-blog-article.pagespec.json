      "content": {
        "heading": "Let the queue breathe",
        "blocks": [
          {
            "kind": "paragraph",
            "text": "A queue that is full at dawn is brittle by noon. Keeping a tenth of capacity free made late arrivals routine instead of urgent."
          }
