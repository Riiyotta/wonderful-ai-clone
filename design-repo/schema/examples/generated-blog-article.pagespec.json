      "content": {
        "heading": "Plan around the fixed points",
        "blocks": [
          {
            "kind": "paragraph",
            "text": "Start with the moments that cannot shift, then place flexible work in the gaps between them."
          },
          {
            "kind": "list",
            "items": [
              "Mark the hard deadlines first",
              "Leave slack after every crossing",
              "Review the plan when the forecast changes"
            ]
          }
        ]
